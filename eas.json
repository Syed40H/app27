{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "demo": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_SEED": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEMO_SEED": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
